# PostgreSQL connection string (use the pooled URL on Neon). Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Set to "require" for managed Postgres (Neon etc.); leave empty for local.
DATABASE_SSL=
# Public base URL of the app, used to build invite/reset links and to check request origin.
APP_URL=http://localhost:3000
# Session idle timeout in hours (FR-003) and how recent a password check must be to approve a bill.
SESSION_IDLE_HOURS=8
REAUTH_MINUTES=15
# Technical per-entry maximum (FR-016).
MAX_HOURS_PER_ENTRY=100000
# Used only by `npm run bootstrap-admin`.
ADMIN_EMAIL=
ADMIN_NAME=
