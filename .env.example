# PostgreSQL connection string (use the pooled URL on Neon). Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Set to "require" for managed Postgres (Neon etc.); leave empty for local.
DATABASE_SSL=
# Public base URL of the app, used to build invite/reset links and to check request origin.
APP_URL=http://localhost:3000
# Comma-separated email domains allowed to be invited and to sign in (e.g. vahan.co). Empty allows any domain.
ALLOWED_EMAIL_DOMAINS=
# Google sign-in (optional). Create an OAuth 2.0 "Web application" client in Google Cloud with the redirect URI
# <APP_URL>/api/v1/auth/google/callback. When both are set, people sign in with Google and passwords and
# invite links are switched off; set PASSWORD_LOGIN=enabled to keep passwords working alongside.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PASSWORD_LOGIN=
# Session idle timeout in hours (FR-003) and how recent a password check must be to approve a bill.
SESSION_IDLE_HOURS=8
REAUTH_MINUTES=15
# Technical per-entry maximum (FR-016).
MAX_HOURS_PER_ENTRY=100000
# Used only by `npm run bootstrap-admin`.
ADMIN_EMAIL=
ADMIN_NAME=
